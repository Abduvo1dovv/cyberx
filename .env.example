# CyberX v1 CTF Edition — copy to .env and edit locally.
# Never commit a real .env. Never put credentials in source.

# 1 = stub adapters (CI / no tools). 0 = real nmap/http/dns adapters.
CYBERX_STUB=1

# SQLite + artifact directory (created automatically).
CYBERX_DATA_DIR=data

# Logging: DEBUG, INFO, WARNING, ERROR
CYBERX_LOG_LEVEL=WARNING

# Mission brakes
CYBERX_MAX_ITERATIONS=50
CYBERX_MAX_RUNTIME=3600

# Optional AI. Fully usable with none. Do not put a real key here.
CYBERX_AI_PROVIDER=none
# CYBERX_AI_API_KEY=
# XAI_API_KEY=
CYBERX_AI_MODEL=grok-4.5
CYBERX_AI_TIMEOUT=8
CYBERX_AI_MAX_CALLS=20
CYBERX_AI_MAX_CALLS_CYCLE=2

# Tool paths / timeouts (real mode only)
CYBERX_NMAP_BIN=nmap
CYBERX_NMAP_TIMEOUT=180
CYBERX_HTTP_TIMEOUT=30
CYBERX_HTTP_TLS_VERIFY=1
CYBERX_DNS_TIMEOUT=30
# CYBERX_DNS_NS=
